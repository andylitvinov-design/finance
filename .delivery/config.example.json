{
  "projectName": "ezohata-incoming-ledger",
  "repository": "andylitvinov-design/finance",
  "defaultBranch": "main",
  "targetBranch": "main",
  "packageManager": "npm",
  "framework": "static-html-vercel-functions",
  "commands": {
    "install": "npm ci",
    "build": "npm run build",
    "lint": null,
    "typecheck": null,
    "test": "node --test tests/*.test.*",
    "check": "bash scripts/release-guard.sh",
    "smokeLive": "node scripts/live-smoke-test.mjs",
    "deployVerify": "node scripts/verify-deployment.mjs"
  },
  "ci": {
    "provider": "github-actions",
    "required": true
  },
  "deployment": {
    "provider": "vercel",
    "productionUrl": "https://ezohata-incoming-ledger.vercel.app",
    "secondaryProductionUrl": null,
    "legacyFallbackUrl": null,
    "previewUrl": null,
    "requiresDashboardAccess": true,
    "autoDeployBranch": "main",
    "defaultDeliveryTarget": "productionUrl",
    "fallbackWorkflow": ".github/workflows/deploy-production.yml"
  },
  "github": {
    "usePullRequests": true,
    "allowAutoMerge": false,
    "requireHumanReview": false,
    "branchProtectionExpected": false
  },
  "liveVerification": {
    "required": true,
    "method": "browser-or-smoke-test",
    "defaultExpectedText": null,
    "routes": [
      "/",
      "/api/status"
    ]
  },
  "costControl": {
    "sameIssueRetryLimit": 3,
    "preferDiffsOverFullFiles": true,
    "stableContextFirst": true,
    "requireCostControlInFinalReport": true
  },
  "security": {
    "neverPrintSecrets": true,
    "blockedSecretNamesOnly": true,
    "requireApprovalForDestructiveActions": true
  },
  "delivery": {
    "final_result_verification_gate": {
      "enabled": true,
      "requireOriginalRequestContract": true,
      "requireRequirementVerificationTable": true,
      "statuses": [
        "PASS",
        "PARTIAL",
        "FAIL",
        "NOT VERIFIED"
      ],
      "completionBlockingStatuses": [
        "PARTIAL",
        "FAIL",
        "NOT VERIFIED"
      ],
      "maxRepairAttempts": 2,
      "completionBlockingStatusesNote": "NOT VERIFIED blocks SUCCESS unless the only missing item is authenticated post-login proof covered by SUCCESS_WITH_AUTH_LIMITATION."
    },
    "final_statuses": [
      "SUCCESS",
      "SUCCESS_WITH_AUTH_LIMITATION",
      "BLOCKED"
    ],
    "auth_boundary_status": "SUCCESS_WITH_AUTH_LIMITATION",
    "auth_boundary_is_not_blocked": true,
    "live_verification_modes": [
      "PUBLIC_LIVE",
      "PREVIEW_DEPLOYMENT",
      "LOCAL_AUTH_SIMULATION",
      "AUTH_BOUNDARY",
      "OWNER_REQUIRED"
    ],
    "auth_boundaries": [
      "NONE",
      "GOOGLE_OAUTH_EXPECTED",
      "SUPABASE_AUTH_EXPECTED",
      "PRIVATE_CABINET_EXPECTED",
      "OWNER_SESSION_REQUIRED"
    ],
    "post_login_statuses": [
      "VERIFIED",
      "SKIPPED_EXPECTED_AUTH_BOUNDARY",
      "OWNER_REQUIRED",
      "NOT_APPLICABLE"
    ]
  }
}
