{
  "outputDirectory": ".",
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/auto-balance-snapshots",
      "schedule": "1 23 * * *"
    },
    {
      "path": "/api/ensure-fx-rates",
      "schedule": "15 23 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/auto-balance-snapshots",
      "destination": "/api/index?action=autoBalanceSnapshots"
    },
    {
      "source": "/api/refresh-all-balances",
      "destination": "/api/index?action=reconcileBalancesAndTransfers"
    },
    {
      "source": "/api/parse-balance-screenshot",
      "destination": "/api/index?action=parseBalanceScreenshot"
    },
    {
      "source": "/api/balance-snapshots",
      "destination": "/api/index?action=balanceSnapshots"
    },
    {
      "source": "/api/balance-pairs",
      "destination": "/api/index?action=balancePairs"
    },
    {
      "source": "/api/backfill-daily-balance-snapshots",
      "destination": "/api/index?action=dailyBalanceBackfill"
    },
    {
      "source": "/api/repair-may-daily-balance-snapshots",
      "destination": "/api/index?action=mayDailyBalanceSnapshotRepair"
    },
    {
      "source": "/api/ensure-fx-rates",
      "destination": "/api/index?action=ensureFxRates"
    },
    {
      "source": "/api/binance-transactions",
      "destination": "/api/index?action=binanceTransactions"
    },
    {
      "source": "/api/payoneer-transactions",
      "destination": "/api/index?action=payoneerTransactions"
    },
    {
      "source": "/api/revolut-transactions",
      "destination": "/api/index?action=revolutTransactions"
    },
    {
      "source": "/api/paypal-manual-balance",
      "destination": "/api/index?action=paypalManualBalance"
    },
    {
      "source": "/api/debug-google",
      "destination": "/api/index?action=debugGoogle"
    },
    {
      "source": "/api/debug-full",
      "destination": "/api/index?action=debugFull"
    },
    {
      "source": "/api/debug-analytics",
      "destination": "/api/index?action=debugAnalytics"
    },
    {
      "source": "/api/debug-ui-state",
      "destination": "/api/index?action=debugUiState"
    },
    {
      "source": "/api/period-balance-reconciliation",
      "destination": "/api/index?action=periodBalanceReconciliation"
    },
    {
      "source": "/api/manual-finance",
      "destination": "/api/index?action=manualWorkbook&route=manual-finance"
    },
    {
      "source": "/api/manual-orders",
      "destination": "/api/index?action=manualWorkbook&route=manual-orders"
    },
    {
      "source": "/api/manual-transfers",
      "destination": "/api/index?action=manualWorkbook&route=manual-transfers"
    },
    {
      "source": "/api/manual-savings",
      "destination": "/api/index?action=manualWorkbook&route=manual-savings"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
